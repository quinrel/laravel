The SplFixedArray class provides the main functionalities of array. The
main differences between a SplFixedArray and a normal PHP array is that
the SplFixedArray is of fixed length and allows only integers within
the range as indexes. The advantage is that it allows a faster array
implementation.";s:64:"␀PHPStan\PhpDocParser\Ast\PhpDoc\TemplateTagValueNode␀attributes";a:2:{s:9:"startLine";i:6;s:7:"endLine";i:11;}}}}s:6:"parent";N;s:14:"typeAliasesMap";a:0:{}s:17:"bypassTypeAliases";b:0;s:18:"typeAliasClassName";N;s:9:"traitData";N;}s:32:"67cca057a7f7b50f1d60e08c15b1d411";O:38:"PHPStan\Analyser\IntermediaryNameScope":9:{s:13:"namespaceUses";r:6;s:9:"className";s:13:"SplFixedArray";s:12:"functionName";s:11:"__construct";s:19:"templatePhpDocNodes";a:0:{}s:6:"parent";O:38:"PHPStan\Analyser\IntermediaryNameScope":9:{s:13:"namespaceUses";r:6;s:9:"className";s:13:"SplFixedArray";s:12:"functionName";N;s:19:"templatePhpDocNodes";a:1:{s:6:"TValue";a:2:{i:0;s:9:"@template";i:1;O:52:"PHPStan\PhpDocParser\Ast\PhpDoc\TemplateTagValueNode":6:{s:4:"name";s:6:"TValue";s:5:"bound";N;s:7:"default";N;s:10:"lowerBound";N;s:11:"description";s:298:"
