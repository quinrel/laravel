includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src/
        - config/
        - database/
    excludePaths:
        - src/Filament/
    tmpDir: build/phpstan
    checkModelProperties: true
    checkOctaneCompatibility: true
    ignoreErrors:
        -
            message: '#Called .env. outside of the config directory#'
            path: config/quinrel.php
        -
            message: '#unknown class Inertia\\Inertia#'
            path: src/Middleware/InertiaSeoMiddleware.php
            reportUnmatched: false
        -
            message: '#Trait Quinrel\\Laravel\\Traits\\HasQuinrelMeta is used zero times and is not analysed.#'
            path: src/Traits/HasQuinrelMeta.php
            reportUnmatched: false
